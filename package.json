{
  "name": "billit-telegram-notifier",
  "version": "1.0.0",
  "description": "Notifications Telegram des nouvelles factures Billit",
  "main": "dist/index-notify.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index-notify.js",
    "dev": "ts-node src/index-notify.ts",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "pm2:start": "npm run build && pm2 start ecosystem-bot.config.js"
  },
  "keywords": [
    "billit",
    "telegram",
    "notifications",
    "factures"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^16.3.1",
    "node-telegram-bot-api": "^0.64.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/node-telegram-bot-api": "^0.64.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  }
}
